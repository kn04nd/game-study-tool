{
  "description": "Game Study Toolkit: study context on session start, guard on shell/file tools, automatic study journal, deliver-first check when a gst agent stops. Quiet outside study workspaces.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [{ "type": "command", "command": "GS_HOOK=session-start . \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\"", "timeout": 15 }]
      },
      {
        "matcher": "compact",
        "hooks": [{ "type": "command", "command": "GS_HOOK=compact-digest . \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\"", "timeout": 10 }]
      }
    ],
    "PreCompact": [
      {
        "hooks": [{ "type": "command", "command": "GS_HOOK=pre-compact . \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\"", "timeout": 15 }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "GS_HOOK=pre-tool . \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\"", "timeout": 10 }]
      },
      {
        "matcher": "Read",
        "hooks": [{ "type": "command", "if": "Read(//**/decomp/**)", "command": "GS_HOOK=pre-tool . \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\"", "timeout": 10 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [{ "type": "command", "command": "GS_HOOK=post-tool . \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\"", "timeout": 10, "async": true }]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^gst:",
        "hooks": [{ "type": "command", "command": "GS_HOOK=subagent-stop . \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\"", "timeout": 10 }]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [{ "type": "command", "command": "GS_HOOK=session-end . \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\"", "timeout": 5 }]
      }
    ]
  }
}
