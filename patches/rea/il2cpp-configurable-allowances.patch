diff --git a/tests/boundary/il2cpp/il2cppMetadataAdmission.test.ts b/tests/boundary/il2cpp/il2cppMetadataAdmission.test.ts
new file mode 100644
index 000000000..3ea729c83
--- /dev/null
+++ b/tests/boundary/il2cpp/il2cppMetadataAdmission.test.ts
@@ -0,0 +1,148 @@
+import { setImmediate } from "node:timers/promises";
+import { writeFile } from "node:fs/promises";
+import { join } from "node:path";
+import { expect, it } from "vitest";
+import { AnalysisResourceConstraintError } from "../../../src/domain/analysisErrorCore.js";
+import { projectAnalysisError } from "../../../src/domain/analysisErrorProjection.js";
+import { ConfigurationError } from "../../../src/domain/configurationErrors.js";
+import { runWithAnalysisOperationSnapshot } from "../../../src/domain/analysisOperationSnapshot.js";
+import { inspectIl2cppMetadataInputSchema } from "../../../src/domain/il2cpp/il2cppMetadata.js";
+import {
+  DEFAULT_IL2CPP_MAX_INPUT_BYTES,
+  DEFAULT_IL2CPP_MAX_OUTPUT_BYTES,
+  MAXIMUM_IL2CPP_MAX_INPUT_BYTES,
+  MAXIMUM_IL2CPP_MAX_OUTPUT_BYTES,
+} from "../../../src/domain/analysisResourceLimits.js";
+import { Il2cppMetadataProvider } from "../../../src/il2cpp/Il2cppMetadataProvider.js";
+import { createIl2cppMetadataFixture } from "../../fixtures/il2cpp/metadata.js";
+import { createTestTempDirectory } from "../../fixtures/temporaryDirectory.js";
+
+/** One provider per inspection, reading only the supplied launch environment. */
+const inspectWith = async (
+  environment: Readonly<NodeJS.ProcessEnv>,
+  input: Parameters<Il2cppMetadataProvider["inspect"]>[0],
+) => {
+  const provider = new Il2cppMetadataProvider(
+    void 0,
+    setImmediate,
+    environment,
+  );
+  try {
+    return await provider.inspect(input);
+  } finally {
+    await provider.close();
+  }
+};
+
+const metadataFile = async (prefix: string) => {
+  const root = await createTestTempDirectory(prefix);
+  const path = join(root, "global-metadata.dat");
+  const bytes = createIl2cppMetadataFixture().bytes;
+  await writeFile(path, bytes);
+  return { path, bytes };
+};
+
+it("keeps the shipped defaults and bounds both caller allowances", () => {
+  expect(DEFAULT_IL2CPP_MAX_INPUT_BYTES).toBe(256 * 1024 * 1024);
+  expect(DEFAULT_IL2CPP_MAX_OUTPUT_BYTES).toBe(64 * 1024 * 1024);
+  const path = "/artifacts/global-metadata.dat";
+  for (const field of ["max_input_bytes", "max_output_bytes"] as const) {
+    const maximum =
+      field === "max_input_bytes"
+        ? MAXIMUM_IL2CPP_MAX_INPUT_BYTES
+        : MAXIMUM_IL2CPP_MAX_OUTPUT_BYTES;
+    expect(
+      inspectIl2cppMetadataInputSchema.safeParse({ path, [field]: maximum })
+        .success,
+    ).toBe(true);
+    for (const rejected of [0, -1, 1.5, maximum + 1])
+      expect(
+        inspectIl2cppMetadataInputSchema.safeParse({ path, [field]: rejected })
+          .success,
+      ).toBe(false);
+  }
+});
+
+it("raises the complete-report allowance per request over the launch setting", async () => {
+  const { path } = await metadataFile("rea-il2cpp-output-admission-");
+  const environment = { REA_IL2CPP_MAX_OUTPUT_BYTES: "256" };
+  const refused = await inspectWith(environment, { path });
+  if (refused.ok) throw new Error("Expected report allowance refusal");
+  expect(refused.error).toBeInstanceOf(AnalysisResourceConstraintError);
+  const projected = projectAnalysisError(refused.error);
+  expect(projected.retryable).toBe(false);
+  expect(projected.remediation.action).toContain("max_output_bytes");
+  expect(projected.remediation.action).toContain("REA_IL2CPP_MAX_OUTPUT_BYTES");
+  expect(projected.remediation.action).toContain("(source setting)");
+  expect(projected.remediation.action).toContain(
+    "No complete metadata inventory is retained",
+  );
+  const admitted = await inspectWith(environment, {
+    path,
+    max_output_bytes: 16 * 1024 * 1024,
+  });
+  expect(admitted.ok).toBe(true);
+});
+
+it("applies a launch setting above the default without a request value", async () => {
+  const { path } = await metadataFile("rea-il2cpp-output-setting-");
+  const tight = await inspectWith({}, { path, max_output_bytes: 256 });
+  expect(tight.ok).toBe(false);
+  const raised = await inspectWith(
+    { REA_IL2CPP_MAX_OUTPUT_BYTES: String(MAXIMUM_IL2CPP_MAX_OUTPUT_BYTES) },
+    { path },
+  );
+  expect(raised.ok).toBe(true);
+});
+
+it("prefers an accepted runtime override to the launch setting", async () => {
+  const { path } = await metadataFile("rea-il2cpp-output-runtime-");
+  const result = await runWithAnalysisOperationSnapshot(
+    { revision: 1, overrides: { "il2cpp.max_output_bytes": 256 } },
+    () => inspectWith({ REA_IL2CPP_MAX_OUTPUT_BYTES: "16777216" }, { path }),
+  );
+  if (result.ok) throw new Error("Expected report allowance refusal");
+  expect(projectAnalysisError(result.error).remediation.action).toContain(
+    "(source runtime)",
+  );
+});
+
+it("names the raisable metadata input allowance on a file-size refusal", async () => {
+  const { path, bytes } = await metadataFile("rea-il2cpp-input-admission-");
+  const refused = await inspectWith({}, { path, max_input_bytes: 16 });
+  if (refused.ok) throw new Error("Expected input allowance refusal");
+  expect(refused.error).toBeInstanceOf(AnalysisResourceConstraintError);
+  const projected = projectAnalysisError(refused.error);
+  expect(projected.remediation.action).toContain("max_input_bytes");
+  expect(projected.remediation.action).toContain("REA_IL2CPP_MAX_INPUT_BYTES");
+  expect(projected.remediation.action).toContain("(source request)");
+  const fromSetting = await inspectWith(
+    { REA_IL2CPP_MAX_INPUT_BYTES: "16" },
+    { path },
+  );
+  expect(fromSetting.ok).toBe(false);
+  const admitted = await inspectWith(
+    { REA_IL2CPP_MAX_INPUT_BYTES: "16" },
+    { path, max_input_bytes: bytes.length },
+  );
+  expect(admitted.ok).toBe(true);
+});
+
+it("refuses an invalid launch setting instead of using the default", async () => {
+  const { path } = await metadataFile("rea-il2cpp-invalid-setting-");
+  for (const [setting, value] of [
+    ["REA_IL2CPP_MAX_INPUT_BYTES", "0"],
+    ["REA_IL2CPP_MAX_OUTPUT_BYTES", "64MiB"],
+    [
+      "REA_IL2CPP_MAX_OUTPUT_BYTES",
+      String(MAXIMUM_IL2CPP_MAX_OUTPUT_BYTES + 1),
+    ],
+  ] as const) {
+    const result = await inspectWith({ [setting]: value }, { path });
+    if (result.ok) throw new Error(`Expected ${setting} refusal`);
+    expect(result.error).toBeInstanceOf(ConfigurationError);
+    expect((result.error as ConfigurationError).settings).toEqual([
+      expect.objectContaining({ setting }),
+    ]);
+  }
+});
