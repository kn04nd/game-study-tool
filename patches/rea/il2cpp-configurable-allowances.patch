diff --git a/src/config/il2cppMetadataAdmission.ts b/src/config/il2cppMetadataAdmission.ts
new file mode 100644
index 000000000..3e56d4225
--- /dev/null
+++ b/src/config/il2cppMetadataAdmission.ts
@@ -0,0 +1,101 @@
+import { z } from "zod";
+import {
+  DEFAULT_IL2CPP_MAX_INPUT_BYTES,
+  DEFAULT_IL2CPP_MAX_OUTPUT_BYTES,
+  MAXIMUM_IL2CPP_MAX_INPUT_BYTES,
+  MAXIMUM_IL2CPP_MAX_OUTPUT_BYTES,
+} from "../domain/analysisResourceLimits.js";
+import { currentAnalysisSettingOverride } from "../domain/analysisOperationSnapshot.js";
+import { ConfigurationError } from "../domain/configurationErrors.js";
+import type { Il2cppMetadataProviderInput } from "../domain/il2cpp/il2cppMetadata.js";
+import { err, ok, type Result } from "../domain/result.js";
+
+export const IL2CPP_INPUT_ADMISSION_SETTING = "REA_IL2CPP_MAX_INPUT_BYTES";
+export const IL2CPP_OUTPUT_ADMISSION_SETTING = "REA_IL2CPP_MAX_OUTPUT_BYTES";
+
+/** One IL2CPP byte allowance and who selected it. */
+export interface Il2cppAdmission {
+  readonly maximumBytes: number;
+  readonly source: "default" | "setting" | "runtime" | "request";
+}
+
+const allowance = (
+  setting: string,
+  defaultBytes: number,
+  maximumBytes: number,
+) => {
+  const constraint = `${setting} must be a positive decimal safe integer in bytes, at most ${String(maximumBytes)}; the default is ${String(defaultBytes)} bytes.`;
+  const schema = z
+    .string()
+    .regex(/^[1-9]\d*$/u, { error: constraint })
+    .transform(Number)
+    .pipe(z.number().int().min(1).max(maximumBytes));
+  /**
+   * A request value wins, then an accepted runtime override; an invalid
+   * setting is refused, never replaced by the default.
+   */
+  const resolve = (
+    requested?: number,
+    runtime?: number,
+    value?: string,
+  ): Result<Il2cppAdmission, ConfigurationError> => {
+    if (requested !== undefined)
+      return ok({ maximumBytes: requested, source: "request" });
+    if (runtime !== undefined)
+      return ok({ maximumBytes: runtime, source: "runtime" });
+    if (value === undefined)
+      return ok({ maximumBytes: defaultBytes, source: "default" });
+    const parsed = schema.safeParse(value);
+    return parsed.success
+      ? ok({ maximumBytes: parsed.data, source: "setting" })
+      : err(
+          new ConfigurationError(constraint, {
+            settings: [{ setting, constraint }],
+          }),
+        );
+  };
+  return { schema, resolve };
+};
+
+const input = allowance(
+  IL2CPP_INPUT_ADMISSION_SETTING,
+  DEFAULT_IL2CPP_MAX_INPUT_BYTES,
+  MAXIMUM_IL2CPP_MAX_INPUT_BYTES,
+);
+const output = allowance(
+  IL2CPP_OUTPUT_ADMISSION_SETTING,
+  DEFAULT_IL2CPP_MAX_OUTPUT_BYTES,
+  MAXIMUM_IL2CPP_MAX_OUTPUT_BYTES,
+);
+
+export const il2cppMaxInputBytesSchema = input.schema;
+export const il2cppMaxOutputBytesSchema = output.schema;
+
+/**
+ * Resolve both allowances for one inspection: an explicit request value wins,
+ * then the launch environment, then the shipped default.
+ */
+export const resolveIl2cppAdmissions = (
+  request: Pick<
+    Il2cppMetadataProviderInput,
+    "max_input_bytes" | "max_output_bytes"
+  >,
+  environment: Readonly<NodeJS.ProcessEnv>,
+): Result<
+  { readonly input: Il2cppAdmission; readonly output: Il2cppAdmission },
+  ConfigurationError
+> => {
+  const inputAdmission = input.resolve(
+    request.max_input_bytes,
+    currentAnalysisSettingOverride("il2cpp.max_input_bytes"),
+    environment[IL2CPP_INPUT_ADMISSION_SETTING],
+  );
+  if (!inputAdmission.ok) return inputAdmission;
+  const outputAdmission = output.resolve(
+    request.max_output_bytes,
+    currentAnalysisSettingOverride("il2cpp.max_output_bytes"),
+    environment[IL2CPP_OUTPUT_ADMISSION_SETTING],
+  );
+  if (!outputAdmission.ok) return outputAdmission;
+  return ok({ input: inputAdmission.value, output: outputAdmission.value });
+};
